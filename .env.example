# Copy to .env and fill in. .env is gitignored. The scripts read it automatically.
# All resources must be in the same region. We used us-east-1.

export AWS_REGION="us-east-1"

# IAM execution role the Training Sessions session assumes.
export ROLE_ARN="arn:aws:iam::YOUR_ACCOUNT_ID:role/YOUR_TRAINING_SESSIONS_ROLE"

# Model package group where checkpoints are saved.
export MODEL_PACKAGE_GROUP_ARN="arn:aws:sagemaker:us-east-1:YOUR_ACCOUNT_ID:model-package-group/paper-summary-dpo"

# S3 location for session outputs.
export OUTPUT_S3_PATH="s3://YOUR_BUCKET/training-sessions/"

# Optional. Defaults to GPT-OSS-20B version 3.43.2 from the SageMaker public hub in AWS_REGION.
# export BASE_MODEL_ARN="arn:aws:sagemaker:us-east-1:aws:hub-content/SageMakerPublicHub/Model/openai-reasoning-gpt-oss-20b/3.43.2"
